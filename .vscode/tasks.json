{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Frontend (React + Vite)",
      "type": "shell",
      "command": "npm --prefix frontend run dev",
      "isBackground": true,
      "problemMatcher": [
        {
          "pattern": [
            {
              "regexp": ".",
              "file": 1,
              "location": 2,
              "message": 3
            }
          ],
          "background": {
            "activeOnStart": true,
            "beginsPattern": ".*",
            "endsPattern": ".*Local:.*http://localhost:3000.*"
          }
        }
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Run Backend (Spring Boot)",
      "type": "shell",
      "command": "cmd /c \"cd backend && mvnw.cmd spring-boot:run\"",
      "isBackground": true,
      "problemMatcher": [
        {
          "pattern": [
            {
              "regexp": ".",
              "file": 1,
              "location": 2,
              "message": 3
            }
          ],
          "background": {
            "activeOnStart": true,
            "beginsPattern": ".*",
            "endsPattern": ".*Started BloodBankApplicationKt.*"
          }
        }
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Run Full Stack (Frontend + Backend)",
      "dependsOn": [
        "Run Frontend (React + Vite)",
        "Run Backend (Spring Boot)"
      ],
      "problemMatcher": []
    }
  ]
}

						"body": {
							"mode": "raw",
							"raw": "{\n  \"adminRemarks\": \"Approved based on trauma unit emergency request.\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/requests/1/approve",
							"host": ["{{baseUrl}}"],
							"path": ["requests", "1", "approve"]

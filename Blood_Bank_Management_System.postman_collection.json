						"body": {
							"mode": "raw",
							"raw": "{\n  \"bloodGroup\": \"O+\",\n  \"requiredUnits\": 2,\n  \"urgency\": \"EMERGENCY\",\n  \"requiredDate\": \"2026-09-10\",\n  \"reason\": \"Urgent surgical transfusion\",\n  \"notes\": \"Operating Room 3\"\n}"
